		sourceColumn: reading_hour
		formatString: MMM d, HH:mm

	partition Telemetry = m
		mode: import
		source =
				let
					Rows = Csv.Document(ScoredTelemetryCsv, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Rows, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Headers, {
					{"timestamp", type datetime},
					{"machine_id", type text},
					{"vibration_mm_s", type number},
					{"temperature_c", type number},
					{"pressure_bar", type number},
					{"motor_current_amp", type number},
					{"injected_fault", type text},
					{"data_split", type text},
					{"pca_1", type number},
					{"pca_2", type number},
					{"pca_error", type number},
					{"fault_score", type number},
					{"alert_cutoff", type number},
					{"anomaly_flag", Int64.Type},
					{"suspected_fault", type text},
					{"review_cue", type text},
					{"outcome", type text}
					}, "en-US"),
					WithDate = Table.AddColumn(Typed, "reading_date", each Date.ToText(Date.From([timestamp]), [Format = "yyyy-MM-dd", Culture = "en-US"]), type text),
					WithHour = Table.AddColumn(WithDate, "reading_hour", each DateTime.From(Date.From([timestamp])) + #duration(0, Time.Hour(DateTime.Time([timestamp])), 0, 0), type datetime)
				in
					WithHour

	annotation PBI_ResultType = Table
