		lineageTag: 3eb5e7ec-5637-5acc-a816-94abb0446a84
		summarizeBy: none
		sourceColumn: pca_error
		formatString: 0.000

	column 'Fault Score'
		dataType: double
		lineageTag: 29427b01-afe4-58f3-9d7f-670a6a650138
		summarizeBy: none
		sourceColumn: fault_score
		formatString: 0.0%

	column 'Score Cutoff'
		dataType: double
		lineageTag: 8b5c54ed-0503-5d30-99d3-f69b6d53d203
		summarizeBy: none
		sourceColumn: alert_cutoff
		formatString: 0.0%
		isHidden

	column 'Anomaly Flag'
		dataType: int64
		lineageTag: 527b1726-bf71-52d9-82fc-db39fc83e079
		summarizeBy: none
		sourceColumn: anomaly_flag
		formatString: 0
		isHidden

	column 'Suspected Fault'
		dataType: string
		lineageTag: 1e14ab96-7a9b-5abf-a9dc-758c933ada80
		summarizeBy: none
		sourceColumn: suspected_fault

	column 'Review Cue'
		dataType: string
		lineageTag: 0b6642b9-c5c2-5308-9220-ff004c456909
		summarizeBy: none
		sourceColumn: review_cue

	column Outcome
		dataType: string
		lineageTag: faf83c66-0064-540c-a313-8eb0ed286c25
