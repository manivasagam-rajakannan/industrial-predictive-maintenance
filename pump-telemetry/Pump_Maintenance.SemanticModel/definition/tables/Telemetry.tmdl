	column 'Data Split'
		dataType: string
		lineageTag: 6f4e61d7-e322-5ae4-aff3-3cbd19dc689e
		summarizeBy: none
		sourceColumn: data_split

	column 'PCA 1'
		dataType: double
		lineageTag: 89e83de2-75b3-5c31-8680-dbb9c83c07ff
