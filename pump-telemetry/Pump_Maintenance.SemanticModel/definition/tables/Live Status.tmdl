		summarizeBy: none
		sourceColumn: reading_clock_ist
		lineageTag: c60cc929-393d-50b0-adec-977f3bc5db12

	column 'Reading ID'
		dataType: int64
		summarizeBy: none
		sourceColumn: reading_id
		lineageTag: db13eb53-3d3a-5bc9-bdd3-f9ba5bb255dd
