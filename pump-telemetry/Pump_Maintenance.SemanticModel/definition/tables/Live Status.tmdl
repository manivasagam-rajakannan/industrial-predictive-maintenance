table 'Live Status'
	lineageTag: fd58bee9-38be-5225-b187-2fe252dce53f

	measure 'Feed Status' = SELECTEDVALUE('Live Status'[Feed State], "Waiting for feed")
		lineageTag: bd1447f1-7e12-5990-8643-f8013309d800

	measure 'Feed Status Color' = SWITCH([Feed Status], "Recent alert", "#BE531E", "Feed paused", "#607789", "Waiting for feed", "#607789", "#07666D")
		lineageTag: 3ec06dbb-8c7c-52c3-9dda-e793791dbe38
		isHidden

	measure 'Last Reading Clock' = SELECTEDVALUE('Live Status'[Clock IST], "—")
		lineageTag: 07a46950-cb71-5069-a173-4ab826f54400

	measure 'Current Fault Score' = MAX('Live Status'[Fault Score])
		lineageTag: 27f969d6-10c3-50c3-a98b-6be56684e69b
		formatString: 0.0%

	measure 'Current Vibration' = MAX('Live Status'[Vibration])
		lineageTag: 145c9375-112c-5d0e-a267-c0adbd5ec8f1
		formatString: 0.00

	measure 'Current Temperature' = MAX('Live Status'[Temperature])
		lineageTag: ecc43226-196a-58a9-8c0c-3fdd7960e7f1
		formatString: 0.0

	measure 'Current Pressure' = MAX('Live Status'[Pressure])
		lineageTag: 27919fc7-3334-58dd-ab04-0f5e7477c2a8
		formatString: 0.00

	measure 'Current Motor Current' = MAX('Live Status'[Motor Current])
		lineageTag: 19b65e17-2ddf-5d52-be5c-73c52d9a071c
		formatString: 0.0

	column 'Feed State'
		dataType: string
		summarizeBy: none
