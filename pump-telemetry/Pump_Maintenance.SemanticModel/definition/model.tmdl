model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects

	annotation __PBI_TimeIntelligenceEnabled = 0
	annotation PBI_QueryOrder = ["PumpPostgresServer", "PumpPostgresDatabase", "ScoredTelemetryCsv", "Telemetry", "Live Status", "Live Readings", "Live Alerts"]

ref table Telemetry
ref table 'Live Status'
ref table 'Live Readings'
ref table 'Live Alerts'
