<?xml version='1.0' encoding='UTF-8'?>
<workbook original-version="26.1" version="26.1" source-build="0.0.0 (0000.0.0.0)" source-platform="win">
  <datasources>
    <datasource inline="true" name="federated.pump_telemetry" version="26.1" caption="Pump telemetry (live PostgreSQL)">
      <connection class="federated">
        <named-connections>
          <named-connection caption="Pump PostgreSQL" name="postgres.pump_live">
            <connection authentication="username-password" class="postgres" dbname="pump_live" odbc-native-protocol="yes" port="55432" server="127.0.0.1" username="pump_reader"/>
          </named-connection>
        </named-connections>
        <relation connection="postgres.pump_live" name="tableau_telemetry" table="[public].[tableau_telemetry]" type="table"/>
        <cols>
          <map key="[reading_id]" value="[tableau_telemetry].[reading_id]"/>
          <map key="[reading_time_ist]" value="[tableau_telemetry].[reading_time_ist]"/>
          <map key="[pump_id]" value="[tableau_telemetry].[pump_id]"/>
          <map key="[vibration_mm_s]" value="[tableau_telemetry].[vibration_mm_s]"/>
          <map key="[temperature_c]" value="[tableau_telemetry].[temperature_c]"/>
          <map key="[pressure_bar]" value="[tableau_telemetry].[pressure_bar]"/>
          <map key="[motor_current_amp]" value="[tableau_telemetry].[motor_current_amp]"/>
          <map key="[fault_score]" value="[tableau_telemetry].[fault_score]"/>
          <map key="[alert_cutoff]" value="[tableau_telemetry].[alert_cutoff]"/>
          <map key="[anomaly_flag]" value="[tableau_telemetry].[anomaly_flag]"/>
          <map key="[fault_group]" value="[tableau_telemetry].[fault_group]"/>
          <map key="[review_cue]" value="[tableau_telemetry].[review_cue]"/>
        </cols>
        <metadata-records>
          <metadata-record class="column">
            <remote-name>reading_id</remote-name>
            <remote-type>20</remote-type>
            <local-name>[reading_id]</local-name>
            <parent-name>[tableau_telemetry]</parent-name>
            <remote-alias>reading_id</remote-alias>
            <ordinal>1</ordinal>
            <local-type>integer</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>reading_time_ist</remote-name>
            <remote-type>7</remote-type>
            <local-name>[reading_time_ist]</local-name>
            <parent-name>[tableau_telemetry]</parent-name>
            <remote-alias>reading_time_ist</remote-alias>
            <ordinal>2</ordinal>
            <local-type>datetime</local-type>
            <aggregation>Year</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>pump_id</remote-name>
            <remote-type>130</remote-type>
            <local-name>[pump_id]</local-name>
            <parent-name>[tableau_telemetry]</parent-name>
            <remote-alias>pump_id</remote-alias>
            <ordinal>3</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>vibration_mm_s</remote-name>
            <remote-type>5</remote-type>
            <local-name>[vibration_mm_s]</local-name>
            <parent-name>[tableau_telemetry]</parent-name>
            <remote-alias>vibration_mm_s</remote-alias>
            <ordinal>4</ordinal>
            <local-type>real</local-type>
            <aggregation>Avg</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>temperature_c</remote-name>
            <remote-type>5</remote-type>
            <local-name>[temperature_c]</local-name>
            <parent-name>[tableau_telemetry]</parent-name>
            <remote-alias>temperature_c</remote-alias>
            <ordinal>5</ordinal>
            <local-type>real</local-type>
            <aggregation>Avg</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>pressure_bar</remote-name>
            <remote-type>5</remote-type>
            <local-name>[pressure_bar]</local-name>
            <parent-name>[tableau_telemetry]</parent-name>
            <remote-alias>pressure_bar</remote-alias>
            <ordinal>6</ordinal>
            <local-type>real</local-type>
            <aggregation>Avg</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>motor_current_amp</remote-name>
            <remote-type>5</remote-type>
            <local-name>[motor_current_amp]</local-name>
            <parent-name>[tableau_telemetry]</parent-name>
            <remote-alias>motor_current_amp</remote-alias>
            <ordinal>7</ordinal>
            <local-type>real</local-type>
            <aggregation>Avg</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>fault_score</remote-name>
            <remote-type>5</remote-type>
            <local-name>[fault_score]</local-name>
            <parent-name>[tableau_telemetry]</parent-name>
            <remote-alias>fault_score</remote-alias>
            <ordinal>8</ordinal>
            <local-type>real</local-type>
            <aggregation>Avg</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>alert_cutoff</remote-name>
            <remote-type>5</remote-type>
            <local-name>[alert_cutoff]</local-name>
            <parent-name>[tableau_telemetry]</parent-name>
            <remote-alias>alert_cutoff</remote-alias>
            <ordinal>9</ordinal>
            <local-type>real</local-type>
            <aggregation>Avg</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>anomaly_flag</remote-name>
            <remote-type>3</remote-type>
            <local-name>[anomaly_flag]</local-name>
            <parent-name>[tableau_telemetry]</parent-name>
            <remote-alias>anomaly_flag</remote-alias>
            <ordinal>10</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>fault_group</remote-name>
            <remote-type>130</remote-type>
            <local-name>[fault_group]</local-name>
            <parent-name>[tableau_telemetry]</parent-name>
            <remote-alias>fault_group</remote-alias>
            <ordinal>11</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>review_cue</remote-name>
            <remote-type>130</remote-type>
            <local-name>[review_cue]</local-name>
            <parent-name>[tableau_telemetry]</parent-name>
            <remote-alias>review_cue</remote-alias>
            <ordinal>12</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled="yes"/>
      <column caption="Reading ID" datatype="integer" name="[reading_id]" role="dimension" type="ordinal"/>
      <column caption="Received time (IST)" datatype="datetime" name="[reading_time_ist]" role="dimension" type="ordinal"/>
      <column caption="Pump ID" datatype="string" name="[pump_id]" role="dimension" type="nominal"/>
      <column caption="Vibration (mm/s)" datatype="real" name="[vibration_mm_s]" role="measure" type="quantitative"/>
      <column caption="Temperature (°C)" datatype="real" name="[temperature_c]" role="measure" type="quantitative"/>
      <column caption="Pressure (bar)" datatype="real" name="[pressure_bar]" role="measure" type="quantitative"/>
      <column caption="Motor current (A)" datatype="real" name="[motor_current_amp]" role="measure" type="quantitative"/>
      <column caption="Fault score" datatype="real" name="[fault_score]" role="measure" type="quantitative" default-format="p0%"/>
      <column caption="Alert cutoff" datatype="real" name="[alert_cutoff]" role="measure" type="quantitative" default-format="p0%"/>
      <column caption="Flagged readings" datatype="integer" name="[anomaly_flag]" role="measure" type="quantitative"/>
      <column caption="Suspected fault" datatype="string" name="[fault_group]" role="dimension" type="nominal"/>
      <column caption="Review cue" datatype="string" name="[review_cue]" role="dimension" type="nominal"/>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Fault Score Trend (IST)">
      <table>
        <view>
          <datasources>
            <datasource name="federated.pump_telemetry" caption="Pump telemetry (live PostgreSQL)"/>
          </datasources>
          <datasource-dependencies datasource="federated.pump_telemetry">
            <column caption="Received time (IST)" datatype="datetime" name="[reading_time_ist]" role="dimension" type="ordinal"/>
            <column-instance column="[reading_time_ist]" derivation="None" name="[none:reading_time_ist:qk]" pivot="key" type="quantitative"/>
            <column caption="Fault score" datatype="real" name="[fault_score]" role="measure" type="quantitative" default-format="p0%"/>
            <column-instance column="[fault_score]" derivation="Avg" name="[avg:fault_score:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <aggregation value="true"/>
        </view>
        <style/>
        <panes>
          <pane>
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Line"/>
            <style>
              <style-rule element="mark">
                <format attr="color" value="#087C7D"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.pump_telemetry].[avg:fault_score:qk]</rows>
        <cols>[federated.pump_telemetry].[none:reading_time_ist:qk]</cols>
      </table>
      <simple-id uuid="{107E0C18-ABED-54BA-8114-38804FFFEF4B}"/>
    </worksheet>
    <worksheet name="Alerts by Suspected Fault">
      <table>
        <view>
          <datasources>
            <datasource name="federated.pump_telemetry" caption="Pump telemetry (live PostgreSQL)"/>
          </datasources>
          <datasource-dependencies datasource="federated.pump_telemetry">
            <column caption="Flagged readings" datatype="integer" name="[anomaly_flag]" role="measure" type="quantitative"/>
            <column-instance column="[anomaly_flag]" derivation="Sum" name="[sum:anomaly_flag:qk]" pivot="key" type="quantitative"/>
            <column caption="Suspected fault" datatype="string" name="[fault_group]" role="dimension" type="nominal"/>
            <column-instance column="[fault_group]" derivation="None" name="[none:fault_group:nk]" pivot="key" type="nominal"/>
          </datasource-dependencies>
          <filter class="categorical" column="[federated.pump_telemetry].[none:fault_group:nk]">
            <groupfilter function="except">
              <groupfilter function="level-members" level="[none:fault_group:nk]"/>
              <groupfilter function="member" level="[none:fault_group:nk]" member="&quot;Monitoring&quot;"/>
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.pump_telemetry].[none:fault_group:nk]</column>
          </slices>
          <aggregation value="true"/>
        </view>
        <style/>
        <panes>
          <pane>
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Bar"/>
            <style>
              <style-rule element="mark">
                <format attr="color" value="#BE531E"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.pump_telemetry].[none:fault_group:nk]</rows>
        <cols>[federated.pump_telemetry].[sum:anomaly_flag:qk]</cols>
      </table>
      <simple-id uuid="{5D3C471E-0C05-5672-A079-2494E50FFEF4}"/>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="Pump Telemetry - Latest Hour">
      <style/>
      <size maxheight="640" maxwidth="1280" minheight="640" minwidth="1280"/>
      <zones>
        <zone id="1" type-v2="layout-basic" x="0" y="0" w="100000" h="100000">
          <zone id="2" type-v2="text" x="1200" y="1800" w="97600" h="10400">
            <formatted-text>
              <run bold="true" fontsize="18" fontcolor="#102C3B">Pump Telemetry</run>
              <run fontsize="10" fontcolor="#466171">   |   Latest hour   |   Live PostgreSQL</run>
            </formatted-text>
          </zone>
          <zone id="3" name="Fault Score Trend (IST)" x="1200" y="14000" w="63400" h="84000" show-title="true">
            <zone-style>
              <format attr="margin" value="8"/>
            </zone-style>
          </zone>
          <zone id="4" name="Alerts by Suspected Fault" x="65800" y="14000" w="33000" h="84000" show-title="true">
            <zone-style>
              <format attr="margin" value="8"/>
            </zone-style>
          </zone>
        </zone>
      </zones>
      <simple-id uuid="{14B4E30C-50E8-5A93-AEE8-D6C5F04674A0}"/>
    </dashboard>
  </dashboards>
  <windows source-height="33">
    <window class="dashboard" name="Pump Telemetry - Latest Hour" maximized="true">
      <viewpoints>
        <viewpoint name="Fault Score Trend (IST)"/>
        <viewpoint name="Alerts by Suspected Fault"/>
      </viewpoints>
      <active id="3"/>
      <simple-id uuid="{234E8EE4-012E-5894-8D08-E3933F91F32C}"/>
    </window>
  </windows>
  <explain-data enabled-for-viewer="false" extreme-values-enabled-for-all="false">
    <explanation-types/>
  </explain-data>
</workbook>
