                "            {\"replay-tableau-4\", \"CNC-02\", \"Synthetic replay\", #datetime(2026, 1, 1, 11, 0, 50), #datetime(2026, 1, 1, 11, 0, 50), #datetime(2026, 1, 1, 11, 0, 0), \"L\", 299.5, 309.3, 1972.0, 19.3, 177.0, 0.00039674667724657806, 0, \"Normal score\", 0, \"ai4i-dt-3c478c87b51e\"},",
